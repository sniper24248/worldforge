      },
      "createdAt": "2026-10-24T14:56:18.807Z"
    },
    {
      "id": "chr_sera",
      "type": "character",
      "name": "瑟拉",
      "aliases": [
        "记账人"
      ],
      "summary": "灰堤最年轻的议员，靠给死人记账上台。",
      "body": "瑟拉三十三岁，出身第四层，是议会史上第一个非顶层的议员。她上任后推动的第一件事，是给每一段被交易的记忆登记来源——这让公会恨她，也让底层第一次有了据可查的价格。\n\n她随身带一本用鱼皮做封面的册子，据说里面记着所有她买过的昨天。",
      "tags": [
        "议员",
        "改革派",
        "城墙议会"
      ],
      "fields": {
        "年龄": "33",
        "所属": "城墙议会",
        "特征": "鱼皮账册，右手常戴薄手套"
      },
      "images": [],
      "graph": {
